{
	"name": "teatralo4ka.odesa.ua",
	"private": true,
	"version": "0.0.289",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"prebuild": "npm run validate-content",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && husky || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:gates": "node scripts/gates.mjs",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"validate-content": "tsx scripts/validate-content.ts",
		"bump-version": "tsx scripts/bump-version.ts",
		"generate-sitemap": "tsx scripts/generate-sitemap.ts",
		"generate-changelog": "tsx scripts/generate-changelog.ts",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"check:rules": "node scripts/firebase-cli.mjs emulators:exec --project demo-teatralo4ka --only firestore,auth \"node scripts/check-rules.mjs\"",
		"emulators": "node scripts/firebase-cli.mjs emulators:start --project demo-teatralo4ka --only firestore,auth",
		"postbuild": "tsx scripts/generate-sitemap.ts && tsx scripts/check-app-version.ts && tsx scripts/check-inline-handlers.ts && tsx scripts/check-bundle-budget.ts && tsx scripts/check-links.ts && tsx scripts/check-geo.ts && tsx scripts/generate-changelog.ts",
		"test:e2e": "npm run build && playwright test",
		"test:e2e:ui": "playwright test --ui",
		"crawl:ats": "tsx scripts/crawl-ats-ua.ts",
		"parse:graduates": "tsx scripts/parse-graduates.ts",
		"build:masters": "tsx scripts/build-master-photos.ts",
		"build:play-cast": "tsx scripts/build-play-cast.ts",
		"photos:graduates": "tsx scripts/fetch-graduate-photos.ts",
		"parse:roster": "tsx scripts/parse-graduate-roster.ts",
		"data:graduates": "tsx scripts/build-graduates-data.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/dompurify": "^3.0.5",
		"@types/node": "^25.5.2",
		"@vitest/coverage-v8": "^3.2.4",
		"dotenv": "^17.4.0",
		"eslint": "^10.8.1",
		"eslint-plugin-svelte": "^3.22.0",
		"firebase-admin": "^13.7.0",
		"globals": "^17.9.0",
		"gray-matter": "^4.0.3",
		"husky": "^9.1.7",
		"jsdom": "^26.1.0",
		"lucide-svelte": "^1.0.1",
		"marked": "^17.0.5",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"svelte-eslint-parser": "^1.8.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^7.3.1",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@tiptap/core": "^3.22.2",
		"@tiptap/extension-code-block-lowlight": "^3.22.2",
		"@tiptap/extension-horizontal-rule": "^3.22.2",
		"@tiptap/extension-image": "^3.22.2",
		"@tiptap/extension-link": "^3.22.2",
		"@tiptap/extension-placeholder": "^3.22.2",
		"@tiptap/extension-table": "^3.22.2",
		"@tiptap/extension-table-cell": "^3.22.2",
		"@tiptap/extension-table-header": "^3.22.2",
		"@tiptap/extension-table-row": "^3.22.2",
		"@tiptap/extension-task-item": "^3.22.2",
		"@tiptap/extension-task-list": "^3.22.2",
		"@tiptap/extension-underline": "^3.22.2",
		"@tiptap/pm": "^3.22.2",
		"@tiptap/starter-kit": "^3.22.2",
		"dompurify": "^3.3.3",
		"firebase": "^12.11.0",
		"isomorphic-dompurify": "^3.8.0",
		"lowlight": "^3.3.0",
		"svelte-i18n": "^4.0.1",
		"tiptap-markdown": "^0.9.0",
		"zod": "^4.3.6"
	}
}
